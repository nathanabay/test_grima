# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacore?schema=public"

# ---- API ----
API_PORT=4000
NODE_ENV=development

# ---- Auth ----
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
MFA_ISSUER="PharmaCore"
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- Notification channels (§35) ----
# Each channel makes a real HTTP call to its provider. A channel whose
# variables are unset stays disabled and its notifications are recorded as
# undelivered with the reason — nothing ever reports a delivery that did not
# happen.

# Email. Any provider with a JSON HTTP API (SendGrid, Mailgun, Postmark).
# The body sent is {from, to, subject, text}.
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM="pharmacore@example.com"
EMAIL_DEFAULT_RECIPIENT=""

# SMS. Body sent is {to, from, message}.
SMS_PROVIDER_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="PharmaCore"
SMS_DEFAULT_RECIPIENT=""

# Telegram Bot API. Both are required.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp Business Cloud API. All three are required.
WHATSAPP_API_URL=""
WHATSAPP_TOKEN=""
WHATSAPP_TO=""

# Web push / FCM.
PUSH_API_URL=""
PUSH_API_KEY=""

# ---- Payment gateway (§53). POS card and mobile-money capture stays
# disabled until this is set; cash is unaffected. ----
PAYMENT_PROVIDER_URL=""
PAYMENT_API_KEY=""

# ---- Backups (§55). Backups contain patient data and are never written unencrypted. ----
BACKUP_ENCRYPTION_KEY=""
BACKUP_DIR="backups"
BACKUP_RETENTION_DAYS=30
# Absolute path to pg_dump when it is not on the service PATH.
PG_DUMP_PATH=""
UPLOAD_DIR="uploads"
