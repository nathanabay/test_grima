# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacore?schema=public"

# ---- API ----
API_PORT=4000
NODE_ENV=development

# ---- Auth ----
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
MFA_ISSUER="PharmaCore"
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- Notifications (adapters are no-op until configured) ----
SMTP_URL=""
SMS_PROVIDER_URL=""
TELEGRAM_BOT_TOKEN=""

# ---- Backups (§55). Backups contain patient data and are never written unencrypted. ----
BACKUP_ENCRYPTION_KEY=""
BACKUP_DIR="backups"
BACKUP_RETENTION_DAYS=30
# Absolute path to pg_dump when it is not on the service PATH.
PG_DUMP_PATH=""
UPLOAD_DIR="uploads"
