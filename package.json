{
  "name": "pharmacore",
  "private": true,
  "version": "0.1.0",
  "description": "PharmaCore — Enterprise Pharmacy Inventory & Management System",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @pharmacore/api test",
    "db:migrate": "pnpm --filter @pharmacore/api prisma migrate dev",
    "db:push": "pnpm --filter @pharmacore/api prisma db push",
    "db:seed": "pnpm --filter @pharmacore/api seed && pnpm --filter @pharmacore/api seed:finalize",
    "db:studio": "pnpm --filter @pharmacore/api prisma studio",
    "test:e2e": "node scripts/e2e-workflow.mjs",
    "test:e2e:procurement": "node scripts/e2e-procurement.mjs",
    "test:e2e:capa": "node scripts/e2e-capa-workflow.mjs",
    "test:e2e:pos": "node scripts/e2e-damage-pos.mjs",
    "test:e2e:warehouse": "node scripts/e2e-warehouse.mjs",
    "test:e2e:enterprise": "node scripts/e2e-enterprise.mjs",
    "test:e2e:lifecycle": "node scripts/e2e-lifecycle.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
