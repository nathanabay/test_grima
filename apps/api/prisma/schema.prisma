// PharmaCore — Enterprise Pharmacy Inventory & Management System
// Datasource: PostgreSQL. All primary keys are UUIDs (§47).
//
// CONVENTION: actor columns (createdById, approvedById, ...) are plain UUID
// columns rather than Prisma relations. Adding relations for every audit
// column would require 80+ back-relation fields on User for no query benefit;
// referential integrity for actors is enforced at the service layer, and every
// mutation is mirrored into audit_logs (§42).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
}

enum PermissionAction {
  CREATE
  READ
  EDIT
  DELETE
  APPROVE
  REJECT
  CANCEL
  PRINT
  EXPORT
  IMPORT
}

enum BatchStatus {
  AVAILABLE
  QUARANTINED
  RELEASED
  BLOCKED
  DAMAGED
  EXPIRED
  RECALLED
  RETURNED
  DESTROYED
}

enum TransactionType {
  PURCHASE_RECEIPT
  SALE
  DISPENSING
  TRANSFER_OUT
  TRANSFER_IN
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT
  DAMAGE
  EXPIRY
  RECALL
  DISPOSAL
  STOCK_COUNT
  RESERVATION
  RESERVATION_RELEASE
}

enum StorageCondition {
  ROOM_TEMPERATURE
  COOL
  REFRIGERATED
  FROZEN
  CONTROLLED_ROOM_TEMPERATURE
}

enum PrescriptionStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  PARTIALLY_DISPENSED
  DISPENSED
  REJECTED
  CANCELLED
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  CLOSED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PROCUREMENT_REVIEW
  FINANCE_REVIEW
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PICKING
  DISPATCHED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum SupplierInvoiceStatus {
  DRAFT
  SUBMITTED
  MATCHED
  DISPUTED
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
