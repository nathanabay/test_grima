/// Three-way match outcome: purchase order vs goods receipt vs invoice (§45).
enum InvoiceMatchStatus {
  UNMATCHED
  MATCHED
  PRICE_VARIANCE
  QUANTITY_VARIANCE
  BOTH_VARIANCE
