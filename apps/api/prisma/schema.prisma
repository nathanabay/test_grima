  CLASS_II
  CLASS_III
}

enum RecallStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum RecallTaskStatus {
  PENDING
  IN_PROGRESS
  RECOVERED
  NOT_RECOVERABLE
  CLOSED
}

enum QuarantineReason {
  QUALITY_INVESTIGATION
  DAMAGED_PACKAGING
  TEMPERATURE_EXCURSION
  SUSPECTED_COUNTERFEIT
  RECALL
  DOCUMENTATION_ISSUE
  SHORT_SHELF_LIFE
  REGULATORY_HOLD
